# Copy to .env and fill in. Never commit .env.
# These same keys must also be set in the Vercel project settings
# (Production + Preview), which is what the deployed site actually reads.

# --- Email (contact form) ---
# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=
# Sender address. Must be on a domain verified in Resend, otherwise
# delivery silently fails for everyone except the Resend account owner.
CONTACT_FROM="ALFA BOX <web@alfabox.es>"
# Comma-separated list of addresses that receive contact-form submissions.
CONTACT_RECIPIENTS=

# Legacy nodemailer/Gmail credentials — unused by the current Resend flow.
EMAIL_USER=
EMAIL_APP_PASSWORD=

# --- Social links (rendered in the footer and contact page) ---
FACEBOOK_LINK=
TWITTER_LINK=
INSTAGRAM_LINK=
TIKTOK_LINK=
YOUTUBE_LINK=

# --- Supabase (competiciones app, currently unpublished) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
