{
    "redirects": [
      {
        "source": "/index.html",
        "destination": "/",
        "permanent": true
      },
      {
        "source": "/index.php",
        "destination": "/",
        "permanent": true
      }
    ],
    "headers": [
      {
        "source": "/:path*",
        "headers": [
          {
            "key": "Link",
            "value": "<https://alfabox.es/:path*>; rel=\"canonical\""
          }
        ]
      }
    ]
}
