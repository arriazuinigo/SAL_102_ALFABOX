---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';
import { getCollection } from 'astro:content';

// Generate paths for all blog posts
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  console.log("Found blog entries:", blogEntries.map(e => e.slug));
  return blogEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// Get the blog post data
const { entry } = Astro.props;

// Ensure entry exists before rendering
if (!entry || !entry.data) {
  throw new Error("Blog entry not found or missing required frontmatter.");
}

console.log("Entry slug:", entry.slug);
console.log("Entry data:", entry.data);

let Content;
try {
  console.log("About to render entry");
  const rendered = await entry.render();
  console.log("Render successful");
  Content = rendered.Content;
} catch (error) {
  if (error instanceof Error) {
    console.error(`Render error for ${entry.slug}:`, error);
    throw new Error(`Error rendering blog entry: ${error.message}`);
  } else {
    console.error(`Render error for ${entry.slug}:`, error);
    throw new Error("Error rendering blog entry: Unknown error type");
  }
}

const formattedDate = new Date(entry.data.date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// SEO metadata
const title = `${entry.data.title} | ALFA BOX Blog`;
const description = entry.data.description;
---

<Layout title={title} description={description}>
  <Header />
  
  <section class="py-32 bg-white">
    <div class="container mx-auto px-4">
      <article class="max-w-3xl mx-auto">
        <div class="mb-8">
          <a href="/blog" class="text-primary hover:underline inline-flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M9.707 16.707a1 1 0 01-1.414 0l-6-6a1 1 0 010-1.414l6-6a1 1 0 011.414 1.414L5.414 9H17a1 1 0 110 2H5.414l4.293 4.293a1 1 0 010 1.414z" clip-rule="evenodd" />
            </svg>
            Volver al blog
          </a>
        </div>
        
        <div class="post-header mb-12">
          <h1 class="text-4xl font-bold text-primary mb-4">{entry.data.title}</h1>
          <p class="text-gray-600 mb-6">Publicado el {formattedDate}</p>
          
          {entry.data.image && (
            <img 
              src={entry.data.image} 
              alt={entry.data.title} 
              class="w-full h-auto rounded-lg shadow-lg mb-8"
            />
          )}
        </div>
        
        <div class="post-content prose prose-lg max-w-none">
          <Content />
          
          {entry.data.youtubeId && (
            <div class="my-12">
              <h2 class="text-2xl font-bold text-primary mb-4">Video relacionado</h2>
              <div class="youtube-embed-wrapper">
                <YouTubeEmbed id={entry.data.youtubeId} title={entry.data.title} />
              </div>
            </div>
          )}
        </div>

        <!-- Social Sharing -->
        <div class="mt-12 pt-8 border-t border-gray-200">
          <h3 class="text-xl font-bold text-primary mb-4">Comparte este artículo</h3>
          <div class="flex space-x-4">
            <a 
              href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(entry.data.title)}&url=${encodeURIComponent(`https://alfabox.es/blog/${entry.slug}`)}`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="bg-[#1DA1F2] text-white px-4 py-2 rounded-md hover:bg-opacity-90 transition-colors"
            >
              Twitter
            </a>
            <a 
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(`https://alfabox.es/blog/${entry.slug}`)}`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="bg-[#4267B2] text-white px-4 py-2 rounded-md hover:bg-opacity-90 transition-colors"
            >
              Facebook
            </a>
            <a 
              href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(`https://alfabox.es/blog/${entry.slug}`)}&title=${encodeURIComponent(entry.data.title)}`} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="bg-[#0077B5] text-white px-4 py-2 rounded-md hover:bg-opacity-90 transition-colors"
            >
              LinkedIn
            </a>
          </div>
        </div>
      </article>
    </div>
  </section>
  
  <Footer />
</Layout>


<style>
  /* Blog post content styling */
  .post-content :global(h1) {
    font-size: 2.25rem;
    font-weight: bold;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--color-primary);
  }
  
  .post-content :global(h2) {
    font-size: 1.875rem;
    font-weight: bold;
    margin-top: 1.75rem;
    margin-bottom: 0.875rem;
    color: var(--color-primary);
  }
  
  .post-content :global(h3) {
    font-size: 1.5rem;
    font-weight: bold;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-primary);
  }
  
  .post-content :global(p) {
    margin-bottom: 1.25rem;
    line-height: 1.7;
    color: var(--color-gray-700);
  }
  
  .post-content :global(ul), .post-content :global(ol) {
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  
  .post-content :global(li) {
    margin-bottom: 0.5rem;
    line-height: 1.7;
    color: var(--color-gray-700);
  }
  
  .post-content :global(ul) {
    list-style-type: disc;
  }
  
  .post-content :global(ol) {
    list-style-type: decimal;
  }
  
  .post-content :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    transition: color 0.2s;
  }
  
  .post-content :global(a:hover) {
    color: #247A83;
  }
  
  .post-content :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    padding-left: 1rem;
    margin-left: 0;
    margin-right: 0;
    margin-bottom: 1.25rem;
    font-style: italic;
    color: var(--color-gray-600);
  }
  
  .post-content :global(code) {
    background-color: #f1f5f9;
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: 0.875em;
  }
  
  .post-content :global(pre) {
    background-color: #1e293b;
    color: #e2e8f0;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin-bottom: 1.25rem;
  }
  
  .post-content :global(pre code) {
    background-color: transparent;
    padding: 0;
    color: inherit;
    font-size: 0.875em;
  }
  
  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    margin: 1.5rem 0;
  }
  
  .post-content :global(hr) {
    border: 0;
    border-top: 1px solid #e5e7eb;
    margin: 2rem 0;
  }
  
  .youtube-embed-wrapper {
    margin: 1.5rem 0;
    border-radius: 0.5rem;
    overflow: hidden;
  }
</style>