---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

// Get all blog posts and sort by date
const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

// SEO metadata
const title = "Blog | ALFA BOX - Cross Training Tudela";
const description = "Artículos y tutoriales sobre CrossFit, entrenamiento funcional y estilo de vida saludable.";
---

<Layout 
  title={title}
  description={description}
>
  <Header />
  
  <section class="py-32 bg-white">
    <div class="container mx-auto px-4">
      <h1 class="text-4xl font-bold text-center mb-4 text-primary">Blog</h1>
      <p class="text-gray-600 text-center mb-12 max-w-2xl mx-auto">
        Artículos y tutoriales sobre CrossFit, entrenamiento funcional y estilo de vida saludable.
      </p>
      
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {sortedPosts.map(post => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            slug={post.slug}
            image={post.data.image}
          />
        ))}
      </div>
    </div>
  </section>
  
  <Footer />
</Layout>