---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero_Navigation_Arrows.astro';
import Services from '../components/Services.astro';
import Location from '../components/Location.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import YouTubeVideo from '../components/YouTubeVideo.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import Schedule from '../components/Schedule.astro';
import BoxSection from '../components/BoxSection.astro';
import InstagramFeed from '../components/InstagramFeed.astro';
  
---

<Layout>
  
  <!-- Hidden H1 for SEO and screen readers -->
  <h1 class="sr-only">
    ALFA BOX - Cross Training Tudela | Entrenamiento Funcional
  </h1>
  
  <Header />
  <Hero />

  <Services />

  <BoxSection /> 

  <YouTubeVideo videoId="WxazE0_cipo" title="Cross Training en AlfaBox" />
  

  
  <!-- <InstagramFeed /> -->

  <!-- <Contact /> -->
  <Footer />
</Layout>


<style>
  /* Visually hidden but accessible */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>