---
// src/components/BoxSection.astro
import PhotoGallery from './PhotoGallery.astro';

const boxImages = [
  {
    src: "/images/pino.jpg",
    alt: "Box training area with equipment"
  },
  {
    src: "/images/sofa.jpg",
    alt: "Members training in our box"
  },
  {
    src: "/images/entrenamiento.jpg",
    alt: "Box facilities overview"
  }
];
---

<!-- Nuestro Box Section -->
<section class="py-16 px-4 bg-gray-50">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-5xl font-black text-center mb-2 uppercase tracking-wider" style="font-family: 'Anton', sans-serif;">
      Nuestro Box
    </h2>
    <h3 class="text-2xl text-center mb-12 text-[#BBA14F]">VEN A CONOCERNOS, EMPIEZA TU DESAFÍO</h3>

    <div class="grid md:grid-cols-2 gap-8 items-center">
      <PhotoGallery images={boxImages} />
      <div class="space-y-6">
        <p class="text-lg">
          El Box es como se llama al lugar donde entrenamos, pero no es solo eso, es un sitio para divertirse, compartir esfuerzo y conocer gente que comparte tu pasión.
        </p>
        <p class="text-lg">
          Contamos con programas de entrenamiento en grupo con plazas limitadas, adaptados a tu nivel, con el seguimiento de un coach pendiente de ti. Además disponemos de planes para entrenamiento libre dentro de nuestro box.
        </p>
        <a 
          href="/contacto" 
          class="inline-block bg-[#2E9CA7] text-white px-8 py-3 rounded-md hover:bg-[#247A83] transition-colors"
        >
          Apúntate ahora
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Override section styling to mimic Contact.astro */
  section {
    padding: 5rem 1rem; /* equivalent to py-20 */
    background-color: #2E9CA7; /* primary background */
    color: white;
  }

  /* Heading styles */
  h2 {
    font-size: 2.25rem; /* similar to text-4xl */
    font-weight: bold;
    text-align: center;
    margin-bottom: 3rem; /* similar spacing to Contact.astro */
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-family: 'Anton', sans-serif;
  }

  h3 {
    font-size: 1.5rem;
    text-align: center;
    margin-bottom: 2rem;
    color: white; /* override original color */
  }

  /* Grid layout for content */
  .grid {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Maintain vertical spacing between children */
  .space-y-6 > * + * {
    margin-top: 1.5rem;
  }

  .text-lg {
    font-size: 1.125rem;
  }

  /* Override the anchor (CTA button) styling to mimic Contact.astro button */
  .space-y-6 a {
    display: inline-block;
    background-color: white;
    color: #2E9CA7;
    padding: 0.75rem 2rem;
    border-radius: 0.375rem;
    transition: background-color 0.3s;
    font-weight: bold;
    text-decoration: none;
  }

  .space-y-6 a:hover {
    background-color: #f0f0f0;
  }
</style>
