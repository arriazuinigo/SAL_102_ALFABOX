---
// src\components\Hero.astro
---

<section class="relative h-[70vh]">
  <div class="swiper h-full">
    <div class="swiper-wrapper">
      <div class="swiper-slide relative">
        <!-- Preload first image -->
        <link rel="preload" as="image" href="/images/angel_estiramientos.jpg" fetchpriority="high">
        <img 
          src="/images/angel_estiramientos.jpg"
          alt="Group training" 
          class="w-full h-full object-cover"
          width="1920"
          height="1080"
          decoding="async"
        >
        <div class="absolute inset-0 bg-black/50"></div>
      </div>

      <div class="swiper-slide relative">
        <img 
          src="https://images.unsplash.com/photo-1534367610401-9f5ed68180aa?q=80&w=2070"
          alt="CrossFit training" 
          class="w-full h-full object-cover"
          loading="lazy"
          width="1920"
          height="1080"
          decoding="async"
        >
        <div class="absolute inset-0 bg-black/50"></div>
      </div>

      <div class="swiper-slide relative">
        <img 
          src="https://images.unsplash.com/photo-1599058917765-a780eda07a3e?q=80&w=2069"
          alt="Group training" 
          class="w-full h-full object-cover"
          loading="lazy"
          width="1920"
          height="1080"
          decoding="async"
        >
        <div class="absolute inset-0 bg-black/50"></div>
      </div>
    </div>
    
    <!-- Add Navigation Arrows
    <div class="swiper-button-prev custom-nav-button"></div>
    <div class="swiper-button-next custom-nav-button"></div> -->
    
    <div class="swiper-pagination"></div>
  </div>
  
  <div class="absolute inset-0 flex items-center justify-center z-10">
    <div class="container mx-auto px-4 text-center text-white">
      <h1 class="text-5xl md:text-6xl font-bold mb-6">
        ENTRENA COMO UN CAMPEÓN
      </h1>
      <p class="text-xl md:text-2xl mb-8">
        Descubre tu verdadero potencial en ALFA BOX
      </p>
      <a 
        href="#contacto" 
        class="bg-primary px-8 py-3 rounded-full font-semibold hover:bg-primary-light transition-colors"
      >
        Prueba una clase gratis
      </a>
    </div>
  </div>
</section>


<style>
  .swiper {
    width: 100%;
    height: 100%;
  }
  
  .swiper-slide {
    width: 100%;
    height: 100%;
  }
  
  :global(.swiper-pagination-bullet) {
    background: white;
  }
  
  :global(.swiper-pagination-bullet-active) {
    background: rgba(46,156,167,255);
  }
 
  /* Custom navigation buttons - white arrows without background */
  .custom-nav-button::after {
    color: white !important;
    font-size: 24px !important;
    font-weight: bold !important;
  }
  
  .custom-nav-button {
    background: transparent !important;
  }
  
  /* Make the pagination bullets white */
  .swiper-pagination-bullet {
    background: white !important;
    opacity: 0.7;
  }
  
  .swiper-pagination-bullet-active {
    opacity: 1;
  }
</style>



<script>
  import Swiper from 'swiper';
  import { Autoplay, Pagination, Navigation } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/pagination';
  import 'swiper/css/navigation';

  // Using the client:load directive in Astro ensures this script runs in the browser
  // Simplified initialization
  let swiperInstance;
  
  function initializeSwiper() {
    swiperInstance = new Swiper('.swiper', {
      modules: [Autoplay, Pagination, Navigation],
      loop: true,
      slidesPerView: 1,
      autoplay: {
        delay: 5000,
        disableOnInteraction: false,
      },
      pagination: {
        el: '.swiper-pagination',
        clickable: true,
      },
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      }
    });
  }

  // Wait for DOM to be ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeSwiper);
  } else {
    initializeSwiper();
  }
  
 
</script>