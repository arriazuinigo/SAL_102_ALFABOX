---
interface Props {
  title: string;
  description: string;
  date: string;
  slug: string;
  image?: string;
}

const { title, description, date, slug, image = "/imagesBlog/default-blog.jpg" } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('en-US', { 
  year: 'numeric', 
  month: 'long', 
  day: 'numeric' 
});
---

<article class="bg-white rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow border border-gray-200">
  <a href={`/blog/${slug}`} class="block overflow-hidden">
    <div class="aspect-square overflow-hidden">
      <img 
        src={image} 
        alt={title} 
        class="w-full h-full object-cover transition-transform duration-300 hover:scale-105"
        loading="lazy"
      />
    </div>
  </a>
  <div class="p-6">
    <p class="text-gray-600 text-sm mb-2">{formattedDate}</p>
    <h2 class="text-xl font-bold text-primary mb-3 hover:text-[#247A83] transition-colors">
      <a href={`/blog/${slug}`}>{title}</a>
    </h2>
    <p class="text-gray-600 mb-4 line-clamp-3">{description}</p>
    <a 
      href={`/blog/${slug}`} 
      class="inline-block bg-primary text-white px-4 py-2 rounded-md hover:bg-[#247A83] transition-colors"
    >
      Leer más
    </a>
  </div>
</article>