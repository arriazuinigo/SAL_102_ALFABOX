---
---
<section id="contacto" class="py-20 bg-primary text-white">
  <div class="container mx-auto px-4">
    <h2 class="text-4xl font-bold text-center mb-12">Únete a Nuestra Comunidad</h2>
    <div class="max-w-2xl mx-auto">
      <form class="space-y-6">
        <div>
          <label for="name" class="block mb-2">Nombre</label>
          <input type="text" id="name" class="w-full p-3 border border-white rounded-lg focus:ring-2 focus:ring-white focus:border-white bg-transparent" required>
        </div>
        <div>
          <label for="email" class="block mb-2">Email</label>
          <input type="email" id="email" class="w-full p-3 border border-white rounded-lg focus:ring-2 focus:ring-white focus:border-white bg-transparent" required>
        </div>
        <div>
          <label for="message" class="block mb-2">Mensaje</label>
          <textarea id="message" rows="4" class="w-full p-3 border border-white rounded-lg focus:ring-2 focus:ring-white focus:border-white bg-transparent" required></textarea>
        </div>
        <button type="submit" class="w-full bg-white text-primary py-3 px-6 rounded-lg hover:bg-gray-100 transition-colors font-bold">
          Empezar Ahora
        </button>
      </form>
    </div>
  </div>
</section>