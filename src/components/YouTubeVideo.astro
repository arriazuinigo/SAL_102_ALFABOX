---
// src/components/YouTubeVideo.astro
// Lazy YouTube facade: renders the thumbnail and only loads the iframe on click.
interface Props {
  videoId: string;
  title?: string;
}

const { videoId, title = "Cross Training en AlfaBox" } = Astro.props;
const thumbnailUrl = `https://img.youtube.com/vi/${videoId}/maxresdefault.jpg`;
---

<!-- Cross Training Section -->
<section class="py-16 px-4 max-w-6xl mx-auto">
  <h2 class="text-4xl font-bold text-center mb-4 text-primary uppercase tracking-wider" style="font-family: 'Anton', sans-serif;">
    Cross Training, Hyrox y Halterofilia
  </h2>
  <div class="text-2xl text-center mb-4 text-[#BBA14F]">QUÉ ES Y EN QUÉ CONSISTE</div>

  <div class="grid md:grid-cols-2 gap-8 items-center">
    <div class="space-y-4">
      <p class="text-lg">
        Cross Training es para todo el mundo! Es un sistema de entrenamiento de fuerza y acondicionamiento basado en ejercicios funcionales constantemente variados.
      </p>
      <p class="text-lg">Mira el video para más información.</p>
      <p class="font-bold text-lg">Ven a probarlo, la primera clase es gratis!</p>
      <a 
        href="/contacto" 
        class="inline-block bg-[#2E9CA7] text-white px-8 py-3 rounded-md hover:bg-[#247A83] transition-colors"
      >
        Apúntate ahora
      </a>
    </div>

    <div class="youtube-container relative w-full pt-[56.25%]">
      <div class="youtube-player" data-id={videoId}>
        <div class="absolute top-0 left-0 w-full h-full">
          <img src={thumbnailUrl} class="w-full h-full object-cover rounded-lg" alt={title} loading="lazy" />
          <div class="absolute inset-0 flex items-center justify-center">
            <button
              type="button"
              class="play-button w-16 h-16 bg-red-600 rounded-full flex items-center justify-center hover:bg-red-700 transition-colors"
              aria-label={`Reproducir vídeo: ${title}`}
            >
              <svg class="w-8 h-8 text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M8 5v14l11-7z"/>
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupYouTubePlayer() {
    document.querySelectorAll('.youtube-player').forEach(player => {
      if (player.hasAttribute('data-ready')) return;
      player.setAttribute('data-ready', '');

      const videoId = player.getAttribute('data-id');
      const playButton = player.querySelector('.play-button');
      if (!playButton) return;

      playButton.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.setAttribute('src', `https://www.youtube.com/embed/${videoId}?autoplay=1`);
        iframe.setAttribute('title', 'YouTube video player');
        iframe.setAttribute('frameborder', '0');
        iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
        iframe.setAttribute('allowfullscreen', '');
        iframe.classList.add('absolute', 'top-0', 'left-0', 'w-full', 'h-full', 'rounded-lg');

        const wrapper = player.querySelector('div');
        if (wrapper) {
          wrapper.innerHTML = '';
          wrapper.appendChild(iframe);
        }
      });
    });
  }

  setupYouTubePlayer();
  document.addEventListener('astro:page-load', setupYouTubePlayer);
</script>
